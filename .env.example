# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CreatorHub

# ── Supabase (project already created: creator-membership-platform) ──
NEXT_PUBLIC_SUPABASE_URL=https://ivszbcegywibwsyryrgu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Baq30q8YZWgtX1Rxg8wByw_g9kWmHUH
# Supabase dashboard → Project Settings → API keys → secret / service_role key. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay (Dashboard → Account & Settings → API keys / Webhooks) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Mux video (Settings → Access tokens, Signing keys, Webhooks) ──
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
# base64-encoded private key exactly as Mux gives it
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# ── Zoom: Server-to-Server OAuth app (meetings) + Meeting SDK app (embedded join) ──
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
ZOOM_WEBHOOK_SECRET=

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM="CreatorHub <hello@yourdomain.com>"

# ── WhatsApp Cloud API (Meta) ──
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# An approved utility template with 2 body variables: {{1}} = name, {{2}} = message
WHATSAPP_TEMPLATE_NAME=platform_update
WHATSAPP_TEMPLATE_LANG=en

# ── Cron (Vercel sends this as Bearer token) ──
CRON_SECRET=
